# Optional backend/.env, parsed as data by ./start.sh (never executed as shell).
# Process environment wins. Only these four bootstrap keys are read.
# Omit DATABASE_PATH to keep separate local/mock/configured default databases.
# Relative database paths resolve from the repository root.
# Explicit paths override mode isolation; local/mock reapply demo configuration.
INCIDENT_OPERATIONS_DATABASE_PATH=backend/data/workbench.db
INCIDENT_OPERATIONS_HOST=127.0.0.1
INCIDENT_OPERATIONS_PORT=8100
INCIDENT_OPERATIONS_FRONTEND_PORT=5174
# Credentials and business connections belong only in the SQLite registry.
# Existing master.key is preserved and must be backed up with the database.
# For trusted-network access, set INCIDENT_OPERATIONS_TRUSTED_HOSTS in the process
# environment. Host/Origin/CSRF controls are not authentication or TLS.
